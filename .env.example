# --- AI ---
GEMINI_API_KEY=

# --- Akses VPS ---
# Isi dengan kode rahasia untuk membuka aplikasi dari HP/browser.
# Jika dikosongkan, aplikasi terbuka tanpa login (jangan dipakai di VPS publik).
ACCESS_TOKEN=

# Domain yang dipakai untuk HTTPS. Sesuaikan kalau pakai subdomain lain.
DOMAIN=klip.sinyalrdm.id
ALLOWED_ORIGINS=https://klip.sinyalrdm.id

# Batas memori container. Naikkan ke 6g jika VPS punya RAM 8 GB+.
MEM_LIMIT=3g
